# EmDash CMS Configuration
# Generate with `pnpm exec emdash secrets generate`
EMDASH_ENCRYPTION_KEY="emdash_enc_v1_replace_with_43_base64url_chars"

# WordPress Source Configuration (Target Site Migration)
# Option A: Connect via WordPress Application Password (Recommended)
WP_URL="https://example-wordpress-site.com"
WP_USER="admin"
WP_APP_PASSWORD="" # 24-character application password from WP Admin -> Users -> Profile

# Option B: Connect via 1-File Helper Plugin (scripts/emdash-export-helper.php)
WP_EXPORT_SECRET="" # Secret key configured in WordPress helper plugin

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
