---
interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  image?: string;
  price?: string | number;
}

const {
  title,
  slug,
  excerpt = "",
  image,
  price,
} = Astro.props;
---

<article class="service-card">
  {image && (
    <a href={`/${slug}`} class="service-image-link">
      <img src={image} alt={title} loading="lazy" class="service-img" />
    </a>
  )}
  <div class="service-body">
    <h3 class="service-title">
      <a href={`/${slug}`}>{title}</a>
    </h3>
    {excerpt && <p class="service-excerpt">{excerpt}</p>}
    <div class="service-footer">
      {price ? (
        <span class="service-price">From <strong>£{price}</strong></span>
      ) : (
        <span class="service-price">Fixed Price Guarantee</span>
      )}
      <a href={`/${slug}`} class="service-cta">
        View Service →
      </a>
    </div>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-xl, 1rem);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.1);
    border-color: var(--color-brand, #0284c7);
  }

  .service-image-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface, #f3f4f6);
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .service-card:hover .service-img {
    transform: scale(1.04);
  }

  .service-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--spacing-5, 1.25rem);
  }

  .service-title {
    font-size: var(--font-size-xl, 1.25rem);
    font-weight: 700;
    margin-bottom: var(--spacing-2, 0.5rem);
    line-height: 1.3;
  }

  .service-title a {
    color: var(--color-text, #111827);
    text-decoration: none;
  }

  .service-title a:hover {
    color: var(--color-brand, #0284c7);
  }

  .service-excerpt {
    color: var(--color-text-secondary, #4b5563);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.5;
    margin-bottom: var(--spacing-4, 1rem);
    flex: 1;
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border-subtle, #f3f4f6);
    padding-top: var(--spacing-3, 0.75rem);
    font-size: var(--font-size-sm, 0.875rem);
  }

  .service-price {
    color: var(--color-text, #111827);
  }

  .service-price strong {
    color: var(--color-brand, #0284c7);
    font-size: 1.1rem;
  }

  .service-cta {
    font-weight: 600;
    color: var(--color-brand, #0284c7);
    text-decoration: none;
  }

  .service-cta:hover {
    text-decoration: underline;
  }
</style>
