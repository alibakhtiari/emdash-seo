---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs = [],
  title = "Frequently Asked Questions",
  subtitle = "Clear answers to common questions about our services and process.",
} = Astro.props;
---

{faqs.length > 0 && (
  <section class="faq-section" id="faq">
    <div class="faq-container">
      {title && <h2 class="faq-heading">{title}</h2>}
      {subtitle && <p class="faq-subtitle">{subtitle}</p>}

      <div class="faq-accordion">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <span class="faq-q-text">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq-section {
    padding: var(--spacing-16, 4rem) var(--spacing-6, 1.5rem);
    background: var(--color-bg, #ffffff);
  }

  .faq-container {
    max-width: 840px;
    margin: 0 auto;
  }

  .faq-heading {
    font-size: var(--font-size-3xl, 2rem);
    font-weight: 700;
    text-align: center;
    color: var(--color-text, #111827);
    margin-bottom: var(--spacing-3, 0.75rem);
    letter-spacing: -0.02em;
  }

  .faq-subtitle {
    text-align: center;
    color: var(--color-muted, #6b7280);
    font-size: var(--font-size-base, 1rem);
    margin-bottom: var(--spacing-8, 2rem);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3, 0.75rem);
  }

  .faq-item {
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-surface, #f9fafb);
    overflow: hidden;
    transition: all 0.2s ease-in-out;
  }

  .faq-item[open] {
    border-color: var(--color-brand, #0284c7);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-4, 1rem) var(--spacing-6, 1.5rem);
    font-weight: 600;
    font-size: var(--font-size-lg, 1.125rem);
    color: var(--color-text, #111827);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-brand, #0284c7);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--spacing-6, 1.5rem) var(--spacing-5, 1.25rem);
    color: var(--color-text-secondary, #374151);
    font-size: var(--font-size-base, 1rem);
    line-height: 1.65;
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    margin-top: 0.25rem;
  }
</style>
