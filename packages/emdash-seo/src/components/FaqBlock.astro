---
import { extractFaqsFromContent } from '../importers/rankmath-importer.js';
import type { FaqItem } from '../types.js';

interface Props {
  faqs?: FaqItem[];
  content?: string;
  title?: string;
  subtitle?: string;
  includeSchema?: boolean;
  class?: string;
}

const {
  faqs: propFaqs,
  content = '',
  title = "Frequently Asked Questions",
  subtitle = "Clear, honest answers about professional cleaning services, drying times, and pricing.",
  includeSchema = false,
  class: className = '',
} = Astro.props;

let faqs: FaqItem[] = [];
if (propFaqs && propFaqs.length > 0) {
  faqs = propFaqs;
} else if (content) {
  faqs = extractFaqsFromContent(content);
}

const faqSchemaJson = includeSchema && faqs.length > 0
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer,
        },
      })),
    })
  : null;
---

{faqs.length > 0 && (
  <section class={`faq-block ${className}`} id="faq">
    <div class="faq-container">
      {title && <h2 class="faq-title">{title}</h2>}
      {subtitle && <p class="faq-subtitle">{subtitle}</p>}

      <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((faq, index) => (
          <details
            class="faq-item"
            open={index === 0}
            itemscope
            itemprop="mainEntity"
            itemtype="https://schema.org/Question"
          >
            <summary class="faq-question">
              <span class="faq-q-text" itemprop="name">{faq.question}</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div
              class="faq-answer"
              itemscope
              itemprop="acceptedAnswer"
              itemtype="https://schema.org/Answer"
            >
              <div itemprop="text" class="faq-answer-content">
                <p>{faq.answer}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    {faqSchemaJson && <script type="application/ld+json" set:html={faqSchemaJson} />}
  </section>
)}

<style>
  .faq-block {
    padding: var(--spacing-12, 3rem) 0;
    margin: var(--spacing-8, 2rem) 0;
  }

  .faq-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-title {
    font-size: var(--font-size-2xl, 1.75rem);
    font-weight: 700;
    color: var(--color-text, #111827);
    margin-bottom: var(--spacing-2, 0.5rem);
    text-align: center;
    letter-spacing: -0.015em;
  }

  .faq-subtitle {
    text-align: center;
    color: var(--color-muted, #6b7280);
    font-size: var(--font-size-base, 1rem);
    margin-bottom: var(--spacing-8, 2rem);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3, 0.75rem);
  }

  .faq-item {
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 0.75rem);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--color-brand, #0284c7);
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.07);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-4, 1rem) var(--spacing-5, 1.25rem);
    font-size: var(--font-size-base, 1.05rem);
    font-weight: 600;
    color: var(--color-text, #111827);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-toggle {
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-brand, #0284c7);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--spacing-5, 1.25rem) var(--spacing-4, 1rem);
    border-top: 1px solid rgba(0, 0, 0, 0.04);
  }

  .faq-answer-content p {
    color: var(--color-text-secondary, #374151);
    font-size: var(--font-size-base, 0.975rem);
    line-height: 1.6;
    margin: 0.5rem 0 0.25rem;
  }
</style>
