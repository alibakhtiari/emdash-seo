---
import { normalizeOgLocale } from '../engine/metadata-utils.js';

interface Props {
  title: string;
  description?: string;
  url: string;
  image?: string;
  imageAlt?: string;
  imageSecureUrl?: string;
  imageType?: string;
  type?: 'website' | 'article' | 'service' | 'product';
  siteName: string;
  locale?: string;
  localeAlternate?: string[];
  twitterCard?: 'summary' | 'summary_large_image';
  twitterSite?: string;
  twitterCreator?: string;
  fbAppId?: string;
  articleTags?: string[];
  articleSection?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = '',
  url,
  image,
  imageAlt,
  imageSecureUrl,
  imageType,
  type = 'website',
  siteName,
  locale = 'en_GB',
  localeAlternate = [],
  twitterCard = 'summary_large_image',
  twitterSite,
  twitterCreator,
  fbAppId,
  articleTags = [],
  articleSection,
  publishedTime,
  modifiedTime,
} = Astro.props;

const normalizedLocale = normalizeOgLocale(locale);
const ogType = type === 'service' ? 'website' : type;
const secureUrl = imageSecureUrl || (image && image.startsWith('https://') ? image : undefined);
const alt = imageAlt || title;
let mimeType = imageType;
if (!mimeType && image) {
  if (image.endsWith('.png')) mimeType = 'image/png';
  else if (image.endsWith('.webp')) mimeType = 'image/webp';
  else if (image.endsWith('.gif')) mimeType = 'image/gif';
  else mimeType = 'image/jpeg';
}
---

<!-- OpenGraph Meta Tags -->
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={normalizedLocale} />
{localeAlternate.map((alt) => (
  <meta property="og:locale:alternate" content={normalizeOgLocale(alt)} />
))}
{fbAppId && <meta property="fb:app_id" content={fbAppId} />}
{image && (
  <>
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={alt} />
  {secureUrl && <meta property="og:image:secure_url" content={secureUrl} />}
  {mimeType && <meta property="og:image:type" content={mimeType} />}
  </>
)}
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{ogType === 'article' && articleSection && (
  <meta property="article:section" content={articleSection} />
)}
{ogType === 'article' && articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image} />}
{image && <meta name="twitter:image:alt" content={alt} />}
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
