---
import { buildConnectedSchemaGraph } from '../engine/schema-builder.js';
import type { EntrySeoMetadata, LocalBusinessInfo } from '../types.js';
import type { BreadcrumbItem } from '../engine/breadcrumbs.js';
import type { TocItem } from '../engine/toc-extractor.js';

interface Props {
  siteUrl: string;
  siteName: string;
  canonicalUrl: string;
  title: string;
  description: string;
  imageUrl?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  breadcrumbs?: BreadcrumbItem[];
  pathname?: string;
  category?: string;
  toc?: TocItem[];
  seo?: EntrySeoMetadata;
  business?: LocalBusinessInfo;
  customGraphNodes?: Record<string, any>[];
}

const {
  siteUrl,
  siteName,
  canonicalUrl,
  title,
  description,
  imageUrl,
  datePublished,
  dateModified,
  authorName,
  breadcrumbs,
  pathname,
  category,
  toc,
  seo,
  business,
  customGraphNodes,
} = Astro.props;

const schemaData = buildConnectedSchemaGraph({
  siteUrl,
  siteName,
  canonicalUrl,
  title,
  description,
  imageUrl,
  datePublished,
  dateModified,
  authorName,
  breadcrumbs,
  pathname,
  category,
  toc,
  seo,
  business,
  customGraphNodes,
});

const jsonLd = JSON.stringify(schemaData);
---

<script type="application/ld+json" set:html={jsonLd} />
