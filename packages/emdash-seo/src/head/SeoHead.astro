---
import OpenGraph from './OpenGraph.astro';
import SchemaGraph from './SchemaGraph.astro';
import { DEFAULT_OPTIONS, DEFAULT_LOCAL_BUSINESS, resolveSeoVariables } from '../config.js';
import type { EntrySeoMetadata, LocalBusinessInfo, AuthorProfile, HowToStep, SeoSiteVerification, SeoArchiveNoindex } from '../types.js';
import { generateAutoBreadcrumbs, type BreadcrumbItem } from '../engine/breadcrumbs.js';
import { extractTableOfContents, type TocItem } from '../engine/toc-extractor.js';
import { extractFaqsFromContent } from '../importers/rankmath-importer.js';
import { cleanOgTitle, generateRobotsDirective, extractTaxonomyTerms } from '../engine/metadata-utils.js';
import type { AlternateLink } from '../engine/hreflang.js';

interface Props {
  entry?: any;
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'service' | 'product';
  siteUrl?: string;
  siteName?: string;
  titleTemplate?: string;
  separator?: string;
  locale?: string;
  localeAlternate?: string[];
  business?: LocalBusinessInfo;
  breadcrumbs?: BreadcrumbItem[];
  toc?: TocItem[];
  content?: string;
  category?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string | AuthorProfile;
  reviewedBy?: AuthorProfile;
  speakableSelectors?: string[];
  howToSteps?: HowToStep[];
  nlwebEndpoint?: string;
  alternateLinks?: AlternateLink[];
  twitterSite?: string;
  twitterCreator?: string;
  fbAppId?: string;
  verification?: SeoSiteVerification;
  ogImageAlt?: string;
  ogImageSecureUrl?: string;
  ogImageType?: string;
  articleTags?: string[];
  articleSection?: string;
  prevUrl?: string;
  nextUrl?: string;
  archiveNoindex?: SeoArchiveNoindex;
}

const {
  entry,
  title: propTitle,
  description: propDescription,
  image: propImage,
  canonicalUrl: propCanonical,
  type = 'website',
  siteUrl = DEFAULT_OPTIONS.siteUrl,
  siteName = DEFAULT_OPTIONS.siteName,
  titleTemplate = DEFAULT_OPTIONS.defaultTitleTemplate,
  separator = DEFAULT_OPTIONS.defaultSeparator,
  locale = 'en_GB',
  localeAlternate = [],
  business = DEFAULT_LOCAL_BUSINESS,
  breadcrumbs: propBreadcrumbs,
  toc: propToc,
  content = '',
  category: propCategory,
  publishedTime,
  modifiedTime,
  author: propAuthor,
  reviewedBy: propReviewedBy,
  speakableSelectors: propSpeakable,
  howToSteps: propHowTo,
  nlwebEndpoint = DEFAULT_OPTIONS.nlwebEndpoint,
  alternateLinks = [],
  twitterSite = DEFAULT_OPTIONS.twitterSite,
  twitterCreator = DEFAULT_OPTIONS.twitterCreator,
  fbAppId = DEFAULT_OPTIONS.fbAppId,
  verification = DEFAULT_OPTIONS.verification,
  ogImageAlt,
  ogImageSecureUrl,
  ogImageType,
  articleTags: propArticleTags,
  articleSection: propArticleSection,
  prevUrl,
  nextUrl,
  archiveNoindex = DEFAULT_OPTIONS.archiveNoindex,
} = Astro.props;

// Fast-path: check if pre-computed head & schema cache exists (< 0.1ms TTFB on Cloudflare Workers)
const cachedHead = entry?.data?.seo?._cachedHead || entry?.seo?._cachedHead;
const cachedSchemaGraph = entry?.data?.seo?._cachedSchemaGraph || entry?.seo?._cachedSchemaGraph;
const hasPrecomputed = Boolean(cachedHead && cachedSchemaGraph);

// Fallback dynamic computation (only executed if precomputed head is absent)
let is404 = false;
let fullTitle = '';
let resolvedDescription = '';
let finalCanonical = '';
let robotsDirective: string | null = null;
let cleanSocialTitle = '';
let finalImage: string | undefined = undefined;
let category: string | undefined = undefined;
let articleTags: string[] = [];
let articleSection: string | undefined = undefined;
let breadcrumbs: BreadcrumbItem[] = [];
let toc: TocItem[] = [];
const cleanSiteUrl = siteUrl.replace(/\/+$/, '');
const currentPath = Astro.url ? Astro.url.pathname : '/';
let seo: EntrySeoMetadata = entry?.data?.seo || entry?.seo || {
  focusKeywords: [],
  noIndex: false,
  noFollow: false,
};

if (!hasPrecomputed) {
  is404 = currentPath === '/404' || currentPath.endsWith('/404') || currentPath.endsWith('/404/');

  const dataTitle = entry?.data?.title || propTitle;
  const rawTitle = seo.metaTitle || propTitle || entry?.data?.title || siteName;
  const templateCtx = {
    title: seo.metaTitle && !seo.metaTitle.includes('%') ? seo.metaTitle : (dataTitle || rawTitle),
    excerpt: entry?.data?.excerpt || propDescription || '',
    date: entry?.createdAt || entry?.data?.createdAt,
    category: entry?.data?.category,
    seoTitle: seo.metaTitle,
    focusKeyword: seo.focusKeywords?.[0],
  };
  const templateOpts = { siteName, defaultSeparator: separator };
  if (is404) {
    fullTitle = `Page not found${separator}${siteName}`;
  } else if (rawTitle.includes('%')) {
    fullTitle = resolveSeoVariables(rawTitle, templateCtx, templateOpts);
  } else if (rawTitle.includes(siteName)) {
    fullTitle = rawTitle;
  } else {
    fullTitle = resolveSeoVariables(titleTemplate || '%title% %separator% %siteName%', { ...templateCtx, title: rawTitle }, templateOpts);
  }

  resolvedDescription = seo.metaDescription || seo.ogDescription || propDescription || entry?.data?.excerpt || '';

  const computedCanonical = `${cleanSiteUrl}${currentPath.endsWith('/') ? currentPath : `${currentPath}/`}`;
  finalCanonical = seo.canonicalUrl || propCanonical || computedCanonical;

  finalImage = seo.ogImage || propImage || entry?.data?.featured_image || DEFAULT_OPTIONS.defaultOgImage;

  cleanSocialTitle = seo.ogTitle || (is404 ? 'Page not found' : cleanOgTitle(rawTitle, siteName, separator));

  robotsDirective = generateRobotsDirective({
    noIndex: seo.noIndex,
    noFollow: seo.noFollow,
    noArchive: seo.noArchive,
    noSnippet: seo.noSnippet,
    maxSnippet: seo.maxSnippet,
    noImageIndex: seo.noImageIndex,
    noTranslate: seo.noTranslate,
    maxImagePreview: seo.maxImagePreview || 'large',
    path: currentPath,
    archiveNoindex,
  });

  const taxonomy = extractTaxonomyTerms(entry?.data);
  category = propCategory || taxonomy.articleSection || entry?.data?.category;
  articleTags = propArticleTags || taxonomy.keywords || [];
  articleSection = propArticleSection || category;

  breadcrumbs =
    propBreadcrumbs && propBreadcrumbs.length > 0
      ? propBreadcrumbs
      : generateAutoBreadcrumbs(currentPath, siteUrl, rawTitle, category);

  toc = propToc || [];
  if (toc.length === 0 && content) {
    const tocResult = extractTableOfContents(content);
    toc = tocResult.toc;
  }

  if ((!seo.faqs || seo.faqs.length === 0) && content) {
    const extractedFaqs = extractFaqsFromContent(content);
    if (extractedFaqs.length > 0) {
      seo.faqs = extractedFaqs;
    }
  }
}
---

{hasPrecomputed ? (
  <Fragment set:html={`${cachedHead}\n${cachedSchemaGraph}`} />
) : (
  <>
    <title>{fullTitle}</title>
    {resolvedDescription && !is404 && <meta name="description" content={resolvedDescription} />}
    {verification?.google && <meta name="google-site-verification" content={verification.google} />}
    {verification?.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification?.yandex && <meta name="yandex-verification" content={verification.yandex} />}
    {verification?.pinterest && <meta name="p:domain_verify" content={verification.pinterest} />}
    {!is404 && !seo.noIndex && <link rel="canonical" href={finalCanonical} />}
    {robotsDirective && <meta name="robots" content={robotsDirective} />}
    {!is404 && prevUrl && <link rel="prev" href={prevUrl} />}
    {!is404 && nextUrl && <link rel="next" href={nextUrl} />}

    {!is404 && alternateLinks && alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {!is404 && nlwebEndpoint && <link rel="nlweb" href={nlwebEndpoint} />}

    <OpenGraph
      title={cleanSocialTitle}
      description={is404 ? '' : (seo.ogDescription || resolvedDescription)}
      url={finalCanonical}
      image={is404 ? undefined : finalImage}
      imageAlt={ogImageAlt}
      imageSecureUrl={ogImageSecureUrl}
      imageType={ogImageType}
      type={seo.ogType || type}
      siteName={siteName}
      locale={locale}
      localeAlternate={localeAlternate.length > 0 ? localeAlternate : alternateLinks.filter((a) => a.hreflang !== 'x-default').map((a) => a.hreflang)}
      twitterCard={seo.twitterCard || 'summary_large_image'}
      twitterSite={twitterSite}
      twitterCreator={twitterCreator}
      fbAppId={fbAppId}
      articleTags={articleTags}
      articleSection={articleSection}
      publishedTime={publishedTime || entry?.createdAt}
      modifiedTime={modifiedTime || entry?.updatedAt}
    />

    {!is404 && (
      <SchemaGraph
        siteUrl={cleanSiteUrl}
        siteName={siteName}
        canonicalUrl={finalCanonical}
        title={fullTitle}
        description={resolvedDescription}
        imageUrl={finalImage}
        datePublished={publishedTime || entry?.createdAt}
        dateModified={modifiedTime || entry?.updatedAt}
        authorName={typeof propAuthor === 'string' ? propAuthor : seo.author?.name || (propAuthor as AuthorProfile)?.name}
        author={typeof propAuthor === 'object' ? propAuthor : seo.author}
        reviewedBy={propReviewedBy || seo.reviewedBy}
        speakableSelectors={propSpeakable || seo.speakableSelectors}
        howToSteps={propHowTo || seo.howToSteps}
        breadcrumbs={breadcrumbs}
        pathname={currentPath}
        category={category}
        toc={toc}
        seo={seo}
        business={business}
      />
    )}
  </>
)}
