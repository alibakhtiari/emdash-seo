{
  "name": "@emdash/plugin-seo",
  "version": "1.1.0",
  "description": "WebABC SEO: Comprehensive Search, Generative AI (GEO) & Answer Engine (AEO) Optimization Suite for EmDash CMS & Astro.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./head": {
      "types": "./src/head/SeoHead.astro",
      "import": "./src/head/SeoHead.astro",
      "default": "./src/head/SeoHead.astro"
    },
    "./head-compiler": {
      "types": "./src/engine/head-compiler.ts",
      "import": "./src/engine/head-compiler.ts",
      "default": "./src/engine/head-compiler.ts"
    },
    "./analyzer": {
      "types": "./src/engine/content-analyzer.ts",
      "import": "./src/engine/content-analyzer.ts",
      "default": "./src/engine/content-analyzer.ts"
    },
    "./semantic": {
      "types": "./src/engine/semantic-analyzer.ts",
      "import": "./src/engine/semantic-analyzer.ts",
      "default": "./src/engine/semantic-analyzer.ts"
    },
    "./schema": {
      "types": "./src/engine/schema-builder.ts",
      "import": "./src/engine/schema-builder.ts",
      "default": "./src/engine/schema-builder.ts"
    },
    "./importers": {
      "types": "./src/importers/rankmath-importer.ts",
      "import": "./src/importers/rankmath-importer.ts",
      "default": "./src/importers/rankmath-importer.ts"
    },
    "./breadcrumbs": {
      "types": "./src/engine/breadcrumbs.ts",
      "import": "./src/engine/breadcrumbs.ts",
      "default": "./src/engine/breadcrumbs.ts"
    },
    "./toc": {
      "types": "./src/engine/toc-extractor.ts",
      "import": "./src/engine/toc-extractor.ts",
      "default": "./src/engine/toc-extractor.ts"
    },
    "./fuzzy": {
      "types": "./src/engine/fuzzy-matcher.ts",
      "import": "./src/engine/fuzzy-matcher.ts",
      "default": "./src/engine/fuzzy-matcher.ts"
    },
    "./indexnow": {
      "types": "./src/engine/indexnow.ts",
      "import": "./src/engine/indexnow.ts",
      "default": "./src/engine/indexnow.ts"
    },
    "./hreflang": {
      "types": "./src/engine/hreflang.ts",
      "import": "./src/engine/hreflang.ts",
      "default": "./src/engine/hreflang.ts"
    },
    "./schema-map": {
      "types": "./src/routes/schema-map.ts",
      "import": "./src/routes/schema-map.ts",
      "default": "./src/routes/schema-map.ts"
    },
    "./api-v1": {
      "types": "./src/routes/api-v1.ts",
      "import": "./src/routes/api-v1.ts",
      "default": "./src/routes/api-v1.ts"
    },
    "./components/Breadcrumbs": {
      "types": "./src/components/Breadcrumbs.astro",
      "import": "./src/components/Breadcrumbs.astro",
      "default": "./src/components/Breadcrumbs.astro"
    },
    "./components/TableOfContents": {
      "types": "./src/components/TableOfContents.astro",
      "import": "./src/components/TableOfContents.astro",
      "default": "./src/components/TableOfContents.astro"
    },
    "./components/FaqBlock": {
      "types": "./src/components/FaqBlock.astro",
      "import": "./src/components/FaqBlock.astro",
      "default": "./src/components/FaqBlock.astro"
    },
    "./components/LiveSentenceHighlighter": {
      "types": "./src/components/LiveSentenceHighlighter.tsx",
      "import": "./src/components/LiveSentenceHighlighter.tsx",
      "default": "./src/components/LiveSentenceHighlighter.tsx"
    },
    "./components/ImageAltAuditorWidget": {
      "types": "./src/components/ImageAltAuditorWidget.tsx",
      "import": "./src/components/ImageAltAuditorWidget.tsx",
      "default": "./src/components/ImageAltAuditorWidget.tsx"
    }
  },
  "keywords": [
    "emdash",
    "astro",
    "seo",
    "schema",
    "json-ld",
    "sitemap",
    "rankmath",
    "yoast",
    "cloudflare-workers"
  ],
  "author": "EmDash Community",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=6.0.0",
    "emdash": ">=1.0.0"
  },
  "dependencies": {}
}
