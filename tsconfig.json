{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ESNext",
		"paths": {
			"@emdash/plugin-seo": ["./packages/emdash-seo/src/index.ts"],
			"@emdash/plugin-seo/*": ["./packages/emdash-seo/src/*"]
		}
	},
	"include": [
		".astro/types.d.ts",
		"**/*",
		"emdash-env.d.ts",
		"worker-configuration.d.ts"
	]
}
